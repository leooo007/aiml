from collections import deque
# BFS Logic:
def bfs(graph, start):
    visited=set()
    queue = deque([start])   
    traversed = []
    visited.add(start)
    while queue :
        node = queue.popleft()
        traversed.append(node)
        for neigh in graph[node]:
            if neigh not in visited:
                visited.add(neigh)
                queue.append(neigh)
    return traversed
# DFS Logic
def dfs(graph, start) :
    visited= set()
    traversed = []
    def dfs_in(node) :
        visited.add(node)
        traversed.append(node)
        for neigh in graph[node]:
            if neigh not in visited:
                dfs_in(neigh)
    dfs_in(start)
    return traversed

